# Copy this file to .env in the project root before running docker-compose.
# Never commit the real .env with production secrets.

# --- PostgreSQL ---
POSTGRES_DB=strangerchat
POSTGRES_USER=strangerchat
POSTGRES_PASSWORD=change_me_in_production

# --- Backend (Spring Boot) ---
DATABASE_URL=jdbc:postgresql://postgres:5432/strangerchat
DATABASE_USERNAME=strangerchat
DATABASE_PASSWORD=change_me_in_production

REDIS_HOST=redis
REDIS_PORT=6379

CORS_ALLOWED_ORIGINS=http://localhost:5173

STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:localhost:3478
TURN_USERNAME=strangerchat
TURN_PASSWORD=strangerchat_turn_secret

# --- Frontend (Vite build args) ---
VITE_WS_URL=http://localhost:8080/ws
VITE_API_URL=http://localhost:8080/api
